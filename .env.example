# ─── Database ───────────────────────────────────────────────────
#
# Which engine to use (must match DATABASE_URL and the schema you generated with `npm run db:generate`):
#   postgres | postgresql  →  prisma/schema.prisma + prisma/migrations/
#   mysql | mariadb         →  prisma/schema.mariadb.prisma + prisma/migrations_mariadb/
# If unset, the URL scheme is used: postgresql:// → Postgres, mysql:// or mariadb:// → MariaDB.
DATABASE_PROVIDER=postgres
#
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
# macOS / Linux (trust auth — no password needed):
#   DATABASE_URL="postgresql://admin@localhost:5432/ecomdb"
#
# Windows (PostgreSQL uses 'postgres' as default superuser):
#   Replace YOUR_POSTGRES_PASSWORD with the password you set during PostgreSQL installation.
#   DATABASE_URL="postgresql://admin:YOUR_POSTGRES_PASSWORD@localhost:5432/ecomdb"
#
# ⚠️  If your password contains special characters (e.g. @, #, !),
#     URL-encode them:  @ → %40   # → %23   ! → %21
#     Example: password "abc@123" → "abc%40123"
DATABASE_URL="postgresql://admin:YOUR_POSTGRES_PASSWORD@localhost:5432/ecomdb"

# ─── Windows only ────────────────────────────────────────────────
# Password for PostgreSQL's built-in 'postgres' superuser.
# This is the password you set when you installed PostgreSQL on Windows.
# Leave blank on macOS/Linux (trust auth is used instead).
POSTGRES_SUPERUSER_PASSWORD=YOUR_POSTGRES_PASSWORD

# ─── Auth ────────────────────────────────────────────────────────
# Change this to a long, random secret in production
JWT_SECRET="change_me_to_a_long_random_secret"

# ─── Server ──────────────────────────────────────────────────────
PORT=3008

# ─── Checkout (optional) ─────────────────────────────────────────
# Flat shipping amount used in checkout summary / place-order (default 50 if unset)
# CHECKOUT_SHIPPING_FLAT=50

# ─── Razorpay (optional) ──────────────────────────────────────────
# Get keys from https://dashboard.razorpay.com/app/keys
# Test mode: Use test keys. Live mode: Use live keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
