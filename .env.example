# ─── Database ───────────────────────────────────────────────────
#
# Which engine to use (must match DATABASE_URL and the schema you generated with `npm run db:generate`):
#   postgres | postgresql  →  prisma/schema.prisma + prisma/migrations/
#   mysql | mariadb         →  prisma/schema.mariadb.prisma + prisma/migrations_mariadb/
# If unset, the URL scheme is used: postgresql:// → Postgres, mysql:// or mariadb:// → MariaDB.
DATABASE_PROVIDER=postgres
#
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
# macOS / Linux (trust auth — no password needed):
#   DATABASE_URL="postgresql://admin@localhost:5432/ecomdb"
#
# Windows (PostgreSQL uses 'postgres' as default superuser):
#   Replace YOUR_POSTGRES_PASSWORD with the password you set during PostgreSQL installation.
#   DATABASE_URL="postgresql://admin:YOUR_POSTGRES_PASSWORD@localhost:5432/ecomdb"
#
# ⚠️  If your password contains special characters (e.g. @, #, !),
#     URL-encode them:  @ → %40   # → %23   ! → %21
#     Example: password "abc@123" → "abc%40123"
DATABASE_URL="postgresql://admin:YOUR_POSTGRES_PASSWORD@localhost:5432/ecomdb"

# ─── Windows only ────────────────────────────────────────────────
# Password for PostgreSQL's built-in 'postgres' superuser.
# This is the password you set when you installed PostgreSQL on Windows.
# Leave blank on macOS/Linux (trust auth is used instead).
POSTGRES_SUPERUSER_PASSWORD=YOUR_POSTGRES_PASSWORD

# ─── Auth ────────────────────────────────────────────────────────
# Change this to a long, random secret in production
JWT_SECRET="change_me_to_a_long_random_secret"

# ─── Server ──────────────────────────────────────────────────────
PORT=3008

# ─── Checkout (optional) ─────────────────────────────────────────
# Flat shipping amount used in checkout summary / place-order (default 50 if unset)
# CHECKOUT_SHIPPING_FLAT=50

# ─── Razorpay (optional) ──────────────────────────────────────────
# Production: store these in the database (AppSetting table) instead of here —
#   PUT /admin/settings/credentials  or  `pnpm db:import-credentials` (then delete from .env).
# Env values below are only used as a fallback when a key has no DB row.
# Get keys from https://dashboard.razorpay.com/app/keys
# Test mode: Use test keys. Live mode: Use live keys.
# LIVE Checkout requires storefront domain(s) whitelisted in Dashboard →
# Account & Settings → Website and app settings (www vs non-www must match).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: Dashboard → Webhooks → secret for POST /payments/razorpay/webhook
# RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ─── Delhivery (optional) ───────────────────────────────────────
# Returned by GET /delhivery/credentials
DELHIVERY_EMAIL=
DELHIVERY_PASSWORD=

# ─── Meta (Facebook) Conversions API (optional) ─────────────────
# Server-side Purchase event tracking — mirrors the browser Meta Pixel Purchase
# event so it can be deduplicated via a shared event_id. Fired automatically
# after a successful ONLINE payment (never for COD/failed/cancelled orders).
# Get these from Meta Events Manager → Data sources → your Pixel/Dataset →
# Settings → Conversions API → Generate access token.
# Production: set real values in `.env.local` (gitignored) — never commit them
# and never expose META_CAPI_ACCESS_TOKEN in frontend code.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Optional: Graph API version (defaults to v21.0 if unset)
# META_CAPI_API_VERSION=v21.0
# Optional: set while testing in Meta Events Manager → Test Events, then
# remove/unset for production traffic.
# META_CAPI_TEST_EVENT_CODE=TEST12345

# ─── Access control rollout ──────────────────────────────────────────────────
# Ownership / admin-only checks on storefront routes. Unset or false = report-only:
# behaviour unchanged, would-be denials logged as "[report-only] would deny".
# Set to true only after the logs show no legitimate client hits them.
# AUTHZ_ENFORCE=true
