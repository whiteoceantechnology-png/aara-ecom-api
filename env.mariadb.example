# MariaDB / MySQL (Prisma `mysql` provider) — copy to `.env` (or merge into your tracked `.env`):
#   cp env.mariadb.example .env
#
# Prisma: `prisma/schema.mariadb.prisma` + `prisma/migrations_mariadb/`
# `DATABASE_PROVIDER` and `DATABASE_URL` must agree: never use postgresql:// here while
# DATABASE_PROVIDER=mariadb (the app validates this on startup).

DATABASE_PROVIDER=mariadb

# Use mysql:// or mariadb:// — both work; the app may rewrite mysql:// for the MariaDB adapter.
# Replace USER, PASSWORD, host, port, database name.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/ecomdb"

# Example:
# DATABASE_URL="mysql://root:yourpassword@localhost:3306/ecomdb"

# JDBC URLs (Java) are normalized at startup, e.g.:
#   jdbc:mariadb://localhost:3306/ecomdb
# Prefer a Node-style URL above when possible.

JWT_SECRET="change_me_to_a_long_random_secret"
PORT=3008

# ─── After copying ───────────────────────────────────────────────────────────
# 1. Create the database in MariaDB, e.g.:  CREATE DATABASE IF NOT EXISTS ecomdb;
# 2. npm install
# 3. npm run db:generate
# 4. First-time schema (creates `prisma/migrations_mariadb/`):
#    npx prisma migrate dev --config=prisma/prisma.config.ts --name init
# 5. npm run db:seed   # optional
# 6. npm run start:dev
#
# Do not run PostgreSQL migration SQL files against MariaDB.
