# PostgreSQL — copy to `.env` (or merge into your tracked `.env`):
#   cp env.postgres.example .env
#
# Prisma: `prisma/schema.prisma` + `prisma/migrations/`
# `DATABASE_PROVIDER` and `DATABASE_URL` must agree (do not mix with a mysql:// URL).

DATABASE_PROVIDER=postgres

# Standard Prisma / Node URL (not JDBC).
# Replace USER, PASSWORD, host, port, database as needed.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ecomdb"

# macOS/Linux trust auth (no password in URL), example:
# DATABASE_URL="postgresql://admin@localhost:5432/ecomdb"
#
# If the password contains @ # ! etc., URL-encode in DATABASE_URL only: @ → %40, # → %23, ! → %21

JWT_SECRET="change_me_to_a_long_random_secret"
PORT=3008

# ─── After copying ───────────────────────────────────────────────────────────
# npm install
# npm run db:generate
# npm run db:migrate          # apply `prisma/migrations/`
# # optional first-time all-in-one (creates user/DB when possible):
# npm run db:setup
# npm run start:dev
